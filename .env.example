# ======================= ASOSIY SOZLAMALAR =======================
# Neon PostgreSQL ulanish manzili (to'g'ridan-to'g'ri, "-pooler"siz host)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Telegram bot tokeni (BotFather)
BOT_TOKEN="123456:ABC..."

# Bosh admin Telegram ID (bu odam botda /admin buyrug'i orqali admin panel havolasini oladi)
ADMIN_TELEGRAM_ID="0"

# Admin panelga kirish paroli (birinchi kirishda shu parol, keyin admin paneldan o'zgartirish mumkin)
ADMIN_PASSWORD="admin123"

# Eng yuqori (platforma) admin paroli — /super panelida do'konlarni boshqarish uchun
SUPER_ADMIN_PASSWORD="super123"

# Sessiya va tokenlar uchun maxfiy kalit (istalgan uzun tasodifiy matn)
JWT_SECRET="sotty-o'zgartiring-bu-kalitni-8f3k2j9d8s7a6f5g4h3j2k1l"

# Backend porti
PORT=4000

# Ommaviy (internetdan ochiladigan) manzil. Bo'sh qoldirilsa ngrok'dan avtomatik aniqlanadi.
PUBLIC_URL=""

# Tunnelni avtomatik ishga tushirish: auto (ngrok, bo'lmasa cloudflared) | ngrok | cloudflared | none
TUNNEL="auto"

# Brauzerda (Telegram'siz) test qilish uchun ruxsat: "true" bo'lsa /app?dev_user=<telegram_id> bilan ochish mumkin
ALLOW_DEV_AUTH="true"
