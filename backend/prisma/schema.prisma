generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Telegram orqali ro'yxatdan o'tgan mijoz (ichki mijozlar bazasi).
/// Izoh: bitoCustomerId/bitoCategoryId maydonlari eski nomlar — endi ichki, ishlatilmaydi (keyingi migratsiyada olib tashlanadi).
model User {
  id             Int      @id @default(autoincrement())
  shopId         Int      @default(1)
  telegramId     BigInt
  tgUsername     String?
  tgFirstName    String?
  name           String?
  phone          String?
  bitoCustomerId String?
  /// Bito'dagi mijoz kategoriyasi (xabar yuborilgach shu qiymat qaytariladi)
  bitoCategoryId String?
  language       String   @default("uz")
  storeId        String   @default("main")
  address        String?
  lat            Float?
  lng            Float?
  step           String   @default("new") // new | phone | name | done
  isBlocked      Boolean  @default(false)
  /// Mijoz balansi: musbat = haqdor (oldindan to'lagan), manfiy = qarzdor
  balance        Float    @default(0)
  /// Oxirgi faollik (bot yoki Mini App) — DAU/WAU/MAU va "faol bo'lmay qolganlar" uchun
  lastActiveAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders    Order[]
  waitlist  Waitlist[]
  events    AppEvent[]
  favorites Favorite[]
  cart      CartItem[]
  cashTx    CashTransaction[]

  @@unique([shopId, telegramId])
  @@index([shopId])
}

/// Mahsulot (ichki katalog). Admin paneldan qo'lda qo'shiladi/tahrirlanadi.
/// Izoh: bitoId — ichki barqaror mahsulot kodi (nom tarixiy; keyingi migratsiyada "code" ga o'zgartiriladi).
model Product {
  id             Int      @id @default(autoincrement())
  shopId         Int      @default(1)
  bitoId         String   @unique
  name           String
  searchKey      String   @default("")
  image          String?
  images         Json     @default("[]")
  price          Float    @default(0)
  /// Tan narx (oxirgi xarid narxi) — foyda hisobi uchun
  costPrice      Float    @default(0)
  priceId        String?
  currencyId     String?
  stock          Float    @default(0)
  /// Har bir do'kon (tashkilot konteksti) bo'yicha narx/qoldiq: { main: {price, stock, available}, s2: {...} }
  stores         Json     @default("{}")
  /// Barcha sinxronlangan narx ro'yxatlari: { <priceId>: amount }
  prices         Json     @default("{}")
  discountPercent Float   @default(0)
  roundStep      Int      @default(0)
  roundMode      String   @default("nearest")
  boxItem        Float    @default(0)
  measure        String?
  measureDecimals Int     @default(0)
  sku            String?
  barcode        String?
  note           String?
  customFields   Json     @default("[]")
  categoryBitoId String?
  categoryName   String?
  /// Bito variant mahsulotlari: ota mahsulot (is_parent) va uning variantlari (parent_id)
  parentBitoId   String?
  isParent       Boolean  @default(false)
  /// Variant atributlari: [{ name: "Rang", value: "Qora" }]
  variantAttrs   Json     @default("[]")
  /// Variant nomi (faqat atributlar): "Qora / S"
  variantLabel   String?
  isAvailableForSale Boolean @default(true)
  isDeleted      Boolean  @default(false)
  // Admin boshqaruvi
  hidden         Boolean  @default(false)
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  bitoUpdatedAt  DateTime?
  bitoCreatedAt  DateTime?
  syncedAt       DateTime @default(now())

  waitlist  Waitlist[]
  favorites Favorite[]
  cartItems CartItem[]
  movements StockMovement[]

  @@index([shopId])
  @@index([categoryBitoId])
  @@index([hidden, sortOrder])
  @@index([parentBitoId])
}

/// Yetkazib beruvchi (xaridlar uchun)
model Supplier {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  name      String
  phone     String?
  note      String?
  createdAt DateTime @default(now())
  movements StockMovement[]

  @@index([shopId])
}

/// Ombor harakati (kirim/chiqim/tuzatish) — qoldiqning to'liq jurnali
model StockMovement {
  id         Int      @id @default(autoincrement())
  shopId     Int      @default(1)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// in = kirim (xarid), out = chiqim (sotuv), adjust = tuzatish (inventarizatsiya)
  type       String
  /// manual | purchase | sale | order
  reason     String   @default("manual")
  /// Harakat miqdori (adjust uchun — farq, manfiy bo'lishi mumkin)
  qty        Float    @default(0)
  /// Birlik narxi (kirimda — tan narx, chiqimda — sotuv narxi)
  unitPrice  Float    @default(0)
  /// Jami summa (qty * unitPrice)
  total      Float    @default(0)
  /// Harakatdan keyingi qoldiq (tarix uchun)
  balance    Float    @default(0)
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Buyurtmaga bog'langan bo'lsa (avtomatik chiqim)
  orderId    Int?
  note       String?
  /// Kim yaratdi (admin/telegram id yoki "tizim")
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([productId, createdAt])
  @@index([reason, createdAt])
  @@index([createdAt])
}

/// Do'kon (tenant) — SaaS ko'p-do'kon tizimi uchun. Har bir do'kon o'z boti,
/// mahsulotlari va sozlamalariga ega bo'ladi (ma'lumot izolyatsiyasi keyingi bosqichda).
model Shop {
  id             Int       @id @default(autoincrement())
  /// URL/kalit (masalan "kokand-dokon") — noyob
  slug           String    @unique
  name           String
  ownerName      String?
  ownerPhone     String?
  /// Do'konning Telegram bot tokeni (BotFather)
  botToken       String?
  botUsername    String?
  /// Tarif: free | basic | pro
  tariff         String    @default("free")
  active         Boolean   @default(true)
  suspended      Boolean   @default(false)
  note           String?
  /// Tarif qachon boshlangan
  tariffStart    DateTime?
  /// Tarif qachongacha to'langan
  paidUntil      DateTime?
  /// Bir vaqtda admin panelga kira oladigan qurilmalar soni (super-admin belgilaydi)
  deviceLimit    Int       @default(3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Admin panel sessiyalari (qurilmalar) — ko'p qurilmani cheklash va super-admin nazorati uchun
model AdminSession {
  id         String   @id @default(cuid())
  shopId     Int
  /// JWT identifikatori (tokendagi jti) — sessiyani bekor qilish uchun
  jti        String   @unique
  device     String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([shopId])
}

/// Do'konlarning obuna (tarif) to'lovlari tarixi — super-admin kiritadi/ko'radi
model ShopPayment {
  id        Int      @id @default(autoincrement())
  shopId    Int
  amount    Float
  tariff    String
  months    Int      @default(1)
  note      String?
  createdAt DateTime @default(now())

  @@index([shopId])
}

/// Aksiya / chegirma qoidasi (savat darajasida qo'llanadi)
model Promotion {
  id         Int       @id @default(autoincrement())
  shopId     Int       @default(1)
  name       String
  /// percent = foizli, fixed = qat'iy summa
  type       String    @default("percent")
  value      Float     @default(0)
  /// Qo'llanish uchun minimal savat summasi (0 = doimo)
  minTotal   Float     @default(0)
  /// Promo-kod (bo'sh = avtomatik qo'llanadi)
  promoCode  String?
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([shopId])
}

/// Kassa harakati (pul kirim/chiqim) — kassa qoldig'ining to'liq jurnali
model CashTransaction {
  id          Int      @id @default(autoincrement())
  shopId      Int      @default(1)
  /// income = kirim (pul keldi), expense = chiqim (pul chiqdi)
  kind        String
  amount      Float    @default(0)
  /// cash | card | transfer | other
  method      String   @default("cash")
  /// sale | debt_payment | purchase | salary | rent | refund | other
  category    String   @default("other")
  note        String?
  /// Mijoz (to'lov/qarz bilan bog'liq bo'lsa)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Buyurtmaga bog'langan bo'lsa
  orderId     Int?
  /// Harakatdan keyingi kassa qoldig'i
  balanceAfter Float   @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([kind, createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Kategoriya (ichki katalog). bitoId — ichki barqaror kategoriya kodi.
model Category {
  id         Int     @id @default(autoincrement())
  shopId     Int     @default(1)
  bitoId     String  @unique
  name       String
  parentId   String?
  image      String?
  itemCount  Int     @default(0)
  hidden     Boolean @default(false)
  sortOrder  Int     @default(0)
  isDeleted  Boolean @default(false)
  syncedAt   DateTime @default(now())

  @@index([shopId])
}

/// Mini App yoki bot orqali berilgan buyurtma (ichki)
model Order {
  id               Int      @id @default(autoincrement())
  shopId           Int      @default(1)
  bitoId           String?  @unique
  number           String?
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  type             String   // delivery | pickup
  storeId          String   @default("main")
  stateId          String?
  stateKey         String?  // new | in_progress | done | canceled | custom
  stateName        String?
  items            Json
  total            Float    @default(0)
  /// Aksiya/chegirma summasi (buyurtma darajasida)
  discount         Float    @default(0)
  /// Qo'llanilgan aksiya nomi
  promoTitle       String?
  itemsCount       Float    @default(0)
  phone            String?
  customerName     String?
  address          String?
  lat              Float?
  lng              Float?
  comment          String?
  groupChatId      String?
  groupMessageId   Int?
  customerMessageId Int?
  history          Json     @default("[]")
  bitoPayload      Json?
  error            String?
  /// To'lov: kutilmoqda | to'landi | bekor qilindi (pending | paid | canceled)
  paymentState     String?
  paymentProvider  String?
  isPaid           Boolean  @default(false)
  paidAt           DateTime?
  /// Buyurtma bajarilganda ombordan chiqim qilinganmi (ikki marta yechmaslik uchun)
  stockApplied     Boolean  @default(false)
  /// Buyurtma bajarilganda kassaga tushum yozilganmi
  cashApplied      Boolean  @default(false)
  payments         Payment[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shopId])
  @@index([userId])
  @@index([stateKey])
}

/// "Kelganda eslating" — kutilayotgan mahsulotlar
model Waitlist {
  id         Int       @id @default(autoincrement())
  shopId     Int       @default(1)
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  productId  Int
  product    Product   @relation(fields: [productId], references: [id])
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, productId])
}

/// Instagram uslubidagi storis (doira). Har birida bir nechta slayd bo'lishi mumkin.
model Story {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  title     String
  cover     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  slides    StorySlide[]

  @@index([shopId])
}

model StorySlide {
  id        Int     @id @default(autoincrement())
  storyId   Int
  story     Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  image     String
  caption   String?
  link      String?
  duration  Int     @default(5)
  buttonText String?
  sortOrder Int     @default(0)
}

/// Bosh sahifadagi aylanma bannerlar
model Banner {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  image     String
  title     String?
  subtitle  String?
  link      String?
  textColor String   @default("#ffffff")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  /// Bannerga biriktirilgan mahsulotlar (bosilganda katalog shular bo'yicha filtrlanadi)
  productIds Json    @default("[]")

  @@index([shopId])
}

/// Admin paneldan boshqariladigan barcha sozlamalar (bo'limlar bo'yicha JSON)
model Setting {
  shopId    Int      @default(1)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([shopId, key])
}

/// Buyurtmalar tushadigan Telegram guruhlari
model AdminGroup {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  chatId    String
  title     String?
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([shopId, chatId])
  @@index([shopId])
}

/// Buyurtma holatini o'zgartira oladigan xodimlar
model Staff {
  id         Int      @id @default(autoincrement())
  shopId     Int      @default(1)
  telegramId String
  name       String?
  username   String?
  role       String   @default("staff") // admin | staff
  /// Ulashish rejimi: Mini App'da faqat katalog+savatcha, buyurtma bermaydi, savatni ulashadi
  shareAdmin Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([shopId, telegramId])
  @@index([shopId])
}

/// Takroriy bildirishnomalarni oldini olish (savdo cheki, to'lov va h.k.)
model SentEvent {
  key       String   @id
  createdAt DateTime @default(now())
}

/// Sinxronizatsiya holati (oxirgi vaqtlar va h.k.)
model SyncState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Bot faoliyati jurnali (admin panelda ko'rish uchun)
model ActivityLog {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  type      String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([createdAt])
}

/// Admin paneldan yuklangan fayllar (rasm/video) — serverda disk vaqtinchalik bo'lgani uchun bazada
model Upload {
  name      String   @id
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

/// Analitika hodisalari (Mini App/bot foydalanuvchi harakatlari): app_open, product_view, search, add_to_cart, ...
model AppEvent {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  /// Telegram platformasi: ios | android | tdesktop | web | weba | macos | bot
  platform  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// "Istaklarim" (Favourites) — mijoz yoqtirgan mahsulotlar
model Favorite {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([shopId])
  @@index([productId])
}

/// Mini App savatchasining serverdagi nusxasi — "necha kishining savatida" ko'rsatkichi uchun
model CartItem {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([shopId])
  @@index([productId, updatedAt])
}

/// Bosh sahifadagi qo'shimcha bloklar: mahsulot to'plamlari ("Hafta bestsellerlari")
/// va mini bloklar ("Mualliflar", "Nashriyotlar") — qo'shimcha maydon qiymatlari bo'yicha
model HomeBlock {
  id        Int      @id @default(autoincrement())
  shopId    Int      @default(1)
  /// products — mahsulotlar qatori; chips — rasmli mini bloklar
  kind      String   @default("products")
  /// manual (qo'lda tanlangan) | featured | new | popular | field (qo'shimcha maydon qiymatlari)
  source    String   @default("manual")
  /// chips va field uchun: cf:<id> | category
  fieldKey  String?
  title     Json     @default("{}")
  /// { shape, size, columns, radius, showTitle, cardStyle }
  style     Json     @default("{}")
  limit     Int      @default(12)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  items     HomeBlockItem[]

  @@index([shopId])
}

model HomeBlockItem {
  id        Int       @id @default(autoincrement())
  blockId   Int
  block     HomeBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  /// products bloki uchun
  productId Int?
  /// chips bloki uchun: maydon qiymati (masalan "Tohir Malik")
  value     String?
  image     String?
  title     String?
  /// Mini blokdagi nom o'lchami (px) — har bir qiymat uchun alohida
  titleSize Int?
  sortOrder Int       @default(0)

  @@index([blockId, sortOrder])
}

/// Adminlar ulashgan savat/mahsulot havolasi (qisqa kod bilan)
model Share {
  code      String   @id
  /// cart | product | category
  kind      String   @default("cart")
  /// { items: [{productId, qty, boxCount}] } yoki { productId } / { categoryId }
  payload   Json     @default("{}")
  createdBy Int?
  opens     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Onlayn to'lov tranzaksiyasi (Payme Merchant API)
model Payment {
  id          Int      @id @default(autoincrement())
  provider    String   @default("payme")
  orderId     Int?
  order       Order?   @relation(fields: [orderId], references: [id])
  userId      Int?
  /// Summa tiyinda (Payme shu birlikda ishlaydi)
  amount      Int
  /// 1 yaratilgan, 2 to'langan, -1 bekor, -2 to'langach bekor
  state       Int      @default(1)
  /// Payme tomonidagi tranzaksiya identifikatori
  paycomId    String?  @unique
  /// Payme'da yaratilgan vaqt (ms)
  paycomTime  BigInt   @default(0)
  createTime  BigInt   @default(0)
  performTime BigInt   @default(0)
  cancelTime  BigInt   @default(0)
  reason      Int?
  account     Json     @default("{}")
  /// Sinov (песочница) kaliti bilan yaratilganmi
  sandbox     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([state])
  @@index([paycomTime])
}
